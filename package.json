{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --plugin prettier-plugin-astro --write .",
    "format:check": "prettier --plugin prettier-plugin-astro --check .",
    "quality:check": "bash ../dotfiles/quality/sync.sh . --check",
    "verify": "pnpm quality:check && pnpm format:check && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.1",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "preact": "^10.29.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
