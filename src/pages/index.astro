---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/Terminal";
import BentoGrid from "../components/BentoGrid.astro";
import GitHubHeatmap from "../components/GitHubHeatmap.astro";
import HomeExperience from "../components/home/HomeExperience.astro";
import HomeFeaturedProjects from "../components/home/HomeFeaturedProjects.astro";
---

<Layout>
  <!-- Hero -->
  <section class="min-h-[calc(100vh-4rem)] flex items-center relative overflow-hidden" id="hero">
    <!-- Interactive dot grid canvas -->
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

    <!-- Gradient orb -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full opacity-15 blur-3xl pointer-events-none transition-transform duration-[2000ms]"
      style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%)"
      id="hero-orb"
    ></div>

    <div class="max-w-5xl mx-auto px-[var(--spacing-container)] w-full relative z-10">
      <div class="max-w-2xl">
        <!-- Greeting -->
        <p class="text-base font-mono text-accent mb-4 opacity-0 hero-reveal" data-delay="0">
          <span class="inline-block w-2 h-2 rounded-full bg-accent mr-2 animate-pulse"></span>
          <span data-i18n-es="Hola, soy">Hey, I'm</span>
        </p>

        <!-- Name -->
        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[1.1] mb-6 opacity-0 hero-reveal"
          data-delay="100"
        >
          Matias
          <br />
          <span class="text-text-secondary">Caliz</span>
          <span class="text-accent">.</span>
        </h1>

        <!-- Rotating role -->
        <div
          class="text-xl sm:text-2xl text-text-secondary leading-relaxed mb-3 opacity-0 hero-reveal"
          data-delay="250"
        >
          <span class="text-text font-medium" id="role-text"></span>
          <span class="inline-block w-[2px] h-6 bg-accent ml-0.5 align-middle" id="role-cursor"></span>
        </div>

        <!-- Tagline -->
        <p
          class="text-base sm:text-lg text-text-tertiary leading-relaxed mb-8 max-w-lg opacity-0 hero-reveal lang-en"
          data-delay="400"
        >
          Currently crafting experiences at
          <a
            href="https://www.despegar.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-accent transition-colors duration-200 underline decoration-border hover:decoration-accent underline-offset-4"
          >
            Despegar
          </a>
          . Previously auditing systems at
          <span class="text-text-secondary">EY</span>.
        </p>
        <p
          class="text-base sm:text-lg text-text-tertiary leading-relaxed mb-8 max-w-lg opacity-0 hero-reveal lang-es"
          data-delay="400"
        >
          Actualmente creando experiencias en
          <a
            href="https://www.despegar.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-secondary hover:text-accent transition-colors duration-200 underline decoration-border hover:decoration-accent underline-offset-4"
          >
            Despegar
          </a>
          . Anteriormente auditando sistemas en
          <span class="text-text-secondary">EY</span>.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 opacity-0 hero-reveal" data-delay="550">
          <a
            href="/projects"
            class="group inline-flex items-center gap-2 px-6 py-3 bg-accent text-white rounded-lg font-medium text-sm hover:bg-accent-hover transition-all duration-200 hover:gap-3"
          >
            <span data-i18n-es="Ver mi trabajo">See my work</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/mati-caliz"
            class="inline-flex items-center gap-2 px-6 py-3 border border-border rounded-lg font-medium text-sm text-text-secondary hover:text-text hover:border-border-hover hover:bg-bg-secondary transition-all duration-200"
          >
            <span data-i18n-es="Contactame">Get in touch</span>
          </a>
        </div>

        <!-- Tech stack pills -->
        <div class="flex flex-wrap gap-2 mt-8 opacity-0 hero-reveal" data-delay="700">
          {["React", "Next.js", "Angular", "Java", "Spring", "TypeScript", "Python", "Docker"].map((tech) => (
            <span class="px-3 py-1 text-xs font-mono text-text-tertiary border border-border rounded-full hover:text-text-secondary hover:border-border-hover transition-colors duration-200">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- Scroll indicator -->
      <div
        class="absolute bottom-8 right-12 flex flex-col items-center gap-2 text-text-tertiary opacity-0 hero-reveal"
        data-delay="900"
      >
        <span class="text-xs font-mono" data-i18n-es="bajar">
          scroll
        </span>
        <div class="w-px h-8 bg-border relative overflow-hidden">
          <div class="w-full h-3 bg-text-tertiary absolute animate-scroll-line"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid -->
  <BentoGrid />

  <!-- Interactive Terminal -->
  <section id="terminal-section" class="py-[var(--spacing-section)] border-t border-border">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
      <div class="grid lg:grid-cols-[1fr_1fr] gap-12 items-start">
        <div class="scroll-reveal">
          <p class="text-xs font-mono text-accent mb-3 uppercase tracking-widest" data-i18n-es="Interactivo">
            Interactive
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4" data-i18n-es="Probá la terminal">
            Try the terminal
          </h2>
          <p class="text-text-secondary leading-relaxed mb-4 lang-en">
            A quick way to explore who I am and what I do. Type{" "}
            <code class="px-1.5 py-0.5 text-xs font-mono bg-bg-secondary rounded border border-border">
              help
            </code>{" "}
            to get started.
          </p>
          <p class="text-text-secondary leading-relaxed mb-4 lang-es">
            Una forma rápida de explorar quién soy y qué hago. Escribí{" "}
            <code class="px-1.5 py-0.5 text-xs font-mono bg-bg-secondary rounded border border-border">
              help
            </code>{" "}
            para empezar.
          </p>
          <div class="space-y-2 text-sm text-text-tertiary lang-en">
            <p>
              Commands like <code class="font-mono text-text-secondary">about</code>,{" "}
              <code class="font-mono text-text-secondary">skills</code>,{" "}
              <code class="font-mono text-text-secondary">projects</code> give you quick info.
            </p>
            <p>
              Use <code class="font-mono text-text-secondary">open projects</code> to navigate directly to
              pages.
            </p>
            <p>
              Arrow keys for command history. <code class="font-mono text-text-secondary">Ctrl+L</code> to
              clear.
            </p>
          </div>
          <div class="space-y-2 text-sm text-text-tertiary lang-es">
            <p>
              Comandos como <code class="font-mono text-text-secondary">about</code>,{" "}
              <code class="font-mono text-text-secondary">skills</code>,{" "}
              <code class="font-mono text-text-secondary">projects</code> te dan info rápida.
            </p>
            <p>
              Usá <code class="font-mono text-text-secondary">open projects</code> para navegar directo a las
              páginas.
            </p>
            <p>
              Flechas para historial de comandos. <code class="font-mono text-text-secondary">Ctrl+L</code>{" "}
              para limpiar.
            </p>
          </div>
        </div>
        <div class="scroll-reveal" style="transition-delay: 150ms;">
          <Terminal client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- GitHub Activity -->
  <section class="py-[var(--spacing-section)] border-t border-border">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
      <GitHubHeatmap />
    </div>
  </section>

  <HomeExperience />

  <HomeFeaturedProjects />
</Layout>

<style>
  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(300%);
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .animate-scroll-line {
    animation: scroll-line 1.5s ease-in-out infinite;
  }

  #role-cursor {
    animation: blink 0.8s ease-in-out infinite;
  }
</style>

<script>
  import "../scripts/homeHero";
</script>
