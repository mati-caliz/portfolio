---
import Layout from "../layouts/Layout.astro";
import { experiences, education, certifications } from "../data/experience";
---

<Layout title="Experience | Matias Caliz" description="From auditing systems at EY to building products at scale at Despegar.">
  <!-- Header -->
  <section class="pt-[var(--spacing-section)] pb-12">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
      <p class="text-sm font-mono text-accent mb-4 uppercase tracking-widest hero-reveal" data-delay="0">Career</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4 hero-reveal" data-delay="100">Experience</h1>
      <p class="text-lg text-text-secondary max-w-xl hero-reveal" data-delay="200">
        From auditing systems at EY to building products at scale. The security background isn't a detour — it's a superpower.
      </p>
    </div>
  </section>

  <!-- Timeline -->
  <section class="pb-[var(--spacing-section)]">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-[11px] sm:left-[15px] top-2 bottom-0 w-px bg-border"></div>

        <div class="space-y-12">
          {experiences.map((exp, i) => (
            <div class="relative pl-10 sm:pl-14 scroll-reveal" style={`transition-delay: ${i * 100}ms;`}>
              <!-- Timeline dot -->
              <div class="absolute left-0 sm:left-1 top-1.5">
                <div class={`w-6 h-6 sm:w-7 sm:h-7 rounded-full border-2 border-border bg-bg flex items-center justify-center ${exp.current ? 'border-accent' : ''}`}>
                  {exp.current ? (
                    <span class="w-2.5 h-2.5 rounded-full bg-accent animate-pulse"></span>
                  ) : (
                    <span class="w-2 h-2 rounded-full bg-text-tertiary"></span>
                  )}
                </div>
              </div>

              <!-- Content card -->
              <div class="group border border-border rounded-2xl p-6 sm:p-8 hover:border-border-hover hover:bg-bg-secondary transition-all duration-300 relative overflow-hidden">
                <!-- Accent glow -->
                <div
                  class="absolute top-0 right-0 w-32 h-32 rounded-full blur-3xl opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"
                  style={`background: ${exp.color};`}
                ></div>

                <div class="relative z-10">
                  <!-- Header -->
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                    <div>
                      <h3 class="text-xl sm:text-2xl font-bold group-hover:text-accent transition-colors duration-200">
                        {exp.company}
                      </h3>
                      <p class="text-sm font-medium text-text-secondary mt-0.5">{exp.role}</p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-xs font-mono text-text-tertiary">{exp.period}</span>
                      {exp.current && (
                        <span class="px-2 py-0.5 text-xs font-mono rounded-full bg-accent/10 text-accent border border-accent/20">
                          Current
                        </span>
                      )}
                    </div>
                  </div>

                  <!-- Location -->
                  <div class="flex items-center gap-1.5 mb-4 text-xs text-text-tertiary">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                    {exp.location}
                  </div>

                  <!-- Description -->
                  <p class="text-sm text-text-secondary leading-relaxed mb-6">
                    {exp.description}
                  </p>

                  <!-- Achievements -->
                  <ul class="space-y-2 mb-6">
                    {exp.achievements.map((achievement) => (
                      <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                        <svg class="w-4 h-4 mt-0.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        <span>{achievement}</span>
                      </li>
                    ))}
                  </ul>

                  <!-- Stack -->
                  <div class="flex flex-wrap gap-1.5">
                    {exp.stack.map((tech) => (
                      <span class="px-2.5 py-0.5 text-xs font-mono text-text-tertiary bg-bg-secondary rounded-lg border border-border">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Bottom accent line -->
                <div
                  class="absolute bottom-0 left-0 right-0 h-px scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"
                  style={`background: ${exp.color};`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Certifications -->
  <section class="py-[var(--spacing-section)] border-t border-border">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16">
        <!-- Education -->
        <div class="scroll-reveal">
          <h2 class="text-xs font-mono text-accent mb-6 uppercase tracking-widest">Education</h2>
          {education.map((edu) => (
            <div class="border border-border rounded-xl p-6 hover:border-border-hover hover:bg-bg-secondary transition-all duration-300">
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class="text-lg font-bold">{edu.institution}</h3>
                <span class="text-xs font-mono text-text-tertiary shrink-0">{edu.period}</span>
              </div>
              <p class="text-sm font-medium text-accent mb-3">{edu.degree}</p>
              <p class="text-sm text-text-secondary leading-relaxed">{edu.description}</p>
            </div>
          ))}
        </div>

        <!-- Certifications & Languages -->
        <div class="space-y-8">
          <div class="scroll-reveal">
            <h2 class="text-xs font-mono text-accent mb-6 uppercase tracking-widest">Certifications</h2>
            <div class="space-y-3">
              {certifications.map((cert) => (
                <div class="flex items-center justify-between border border-border rounded-xl p-4 hover:border-border-hover hover:bg-bg-secondary transition-all duration-300">
                  <div>
                    <h3 class="text-sm font-semibold">{cert.name}</h3>
                    <p class="text-xs text-text-tertiary">{cert.issuer}</p>
                  </div>
                  <span class="text-xs font-mono text-text-tertiary">{cert.year}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="scroll-reveal">
            <h2 class="text-xs font-mono text-accent mb-6 uppercase tracking-widest">Languages</h2>
            <div class="space-y-3">
              <div class="flex items-center justify-between border border-border rounded-xl p-4 hover:border-border-hover hover:bg-bg-secondary transition-all duration-300">
                <span class="text-sm font-semibold">Spanish</span>
                <span class="text-xs font-mono text-text-tertiary">Native</span>
              </div>
              <div class="flex items-center justify-between border border-border rounded-xl p-4 hover:border-border-hover hover:bg-bg-secondary transition-all duration-300">
                <div>
                  <span class="text-sm font-semibold">English</span>
                  <span class="text-xs text-text-tertiary ml-2">Cambridge B2 — targeting Advanced in 2026</span>
                </div>
                <span class="text-xs font-mono text-text-tertiary">B2</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 border-t border-border">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)] text-center scroll-reveal">
      <p class="text-text-secondary mb-6">Interested in working together?</p>
      <a
        href="mailto:matias.caliz@gmail.com"
        class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-white rounded-lg font-medium text-sm hover:bg-accent-hover transition-colors duration-200"
      >
        Get in touch
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

