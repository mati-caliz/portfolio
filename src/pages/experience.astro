---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Experience | Matias Caliz">
  <section class="py-[var(--spacing-section)]">
    <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
      <p class="text-sm font-mono text-accent mb-4 uppercase tracking-widest">Career</p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">Experience</h1>
      <p class="text-lg text-text-secondary max-w-xl">
        From auditing systems at EY to building products at scale.
      </p>

      <div class="mt-16 text-text-tertiary text-sm font-mono">
        Coming soon...
      </div>
    </div>
  </section>
</Layout>
