---
import type { Project } from "../../data/projects";

interface Props {
  previousProject: Project | undefined;
  nextProject: Project | undefined;
}

const { previousProject, nextProject } = Astro.props;
---

<section class="border-t border-border">
  <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
    <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border">
      <!-- Previous -->
      <div class="py-12 sm:pr-8">
        {previousProject ? (
          <a href={`/projects/${previousProject.slug}`} class="group block">
            <span class="text-xs font-mono text-text-tertiary mb-2 block" data-i18n-es="Proyecto anterior">
              Previous project
            </span>
            <span class="text-lg font-semibold group-hover:text-accent transition-colors duration-200 flex items-center gap-2">
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
                ></path>
              </svg>
              {previousProject.title}
            </span>
          </a>
        ) : (
          <a href="/projects" class="group block">
            <span class="text-xs font-mono text-text-tertiary mb-2 block" data-i18n-es="Volver a">
              Back to
            </span>
            <span class="text-lg font-semibold group-hover:text-accent transition-colors duration-200 flex items-center gap-2">
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
                ></path>
              </svg>
              <span data-i18n-es="Todos los Proyectos">All Projects</span>
            </span>
          </a>
        )}
      </div>

      <!-- Next -->
      <div class="py-12 sm:pl-8 text-right">
        {nextProject ? (
          <a href={`/projects/${nextProject.slug}`} class="group block">
            <span class="text-xs font-mono text-text-tertiary mb-2 block" data-i18n-es="Siguiente proyecto">
              Next project
            </span>
            <span class="text-lg font-semibold group-hover:text-accent transition-colors duration-200 flex items-center gap-2 justify-end">
              {nextProject.title}
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                ></path>
              </svg>
            </span>
          </a>
        ) : (
          <a href="/projects" class="group block">
            <span class="text-xs font-mono text-text-tertiary mb-2 block" data-i18n-es="Volver a">
              Back to
            </span>
            <span class="text-lg font-semibold group-hover:text-accent transition-colors duration-200 flex items-center gap-2 justify-end">
              <span data-i18n-es="Todos los Proyectos">All Projects</span>
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                ></path>
              </svg>
            </span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
