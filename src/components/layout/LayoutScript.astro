<script is:inline>
  const HEADER_HIDE_THRESHOLD_PX = 80;
  const HERO_REVEAL_BASE_DELAY_MS = 100;

  function preferredLang() {
    return (
      localStorage.getItem("lang") ||
      ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en")
    );
  }

  function preferredTheme() {
    return (
      localStorage.getItem("theme") ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
    );
  }

  function applyLang(lang) {
    const isSpanish = lang === "es";
    document.documentElement.setAttribute("data-lang", lang);
    document.documentElement.lang = isSpanish ? "es-AR" : "en";
    for (const element of document.querySelectorAll("[data-i18n-es]")) {
      if (!element.getAttribute("data-i18n-en")) {
        element.setAttribute("data-i18n-en", element.textContent);
      }
      element.textContent = element.getAttribute(isSpanish ? "data-i18n-es" : "data-i18n-en");
    }
    const langButton = document.getElementById("lang-toggle");
    if (langButton) {
      langButton.textContent = isSpanish ? "ES" : "EN";
    }
    window.dispatchEvent(new CustomEvent("langchange", { detail: { lang } }));
  }

  function initCommandPaletteHint() {
    const commandPaletteHint = document.getElementById("cmd-k-hint");
    if (commandPaletteHint) {
      commandPaletteHint.onclick = function () {
        window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", metaKey: true }));
      };
    }
  }

  function initLanguageToggle() {
    let currentLang = preferredLang();
    applyLang(currentLang);
    const langToggle = document.getElementById("lang-toggle");
    if (langToggle) {
      langToggle.onclick = function () {
        currentLang = currentLang === "en" ? "es" : "en";
        localStorage.setItem("lang", currentLang);
        applyLang(currentLang);
      };
    }
  }

  function showThemeIcon(icon, isVisible, hiddenRotation) {
    icon.style.setProperty("opacity", isVisible ? "1" : "0");
    icon.style.setProperty(
      "transform",
      isVisible ? "rotate(0deg) scale(1)" : `rotate(${hiddenRotation}) scale(0)`,
    );
  }

  function applyTheme(theme) {
    const root = document.documentElement;
    root.classList.remove("light", "dark");
    root.classList.add(theme);
    showThemeIcon(document.getElementById("sun-icon"), theme === "dark", "-90deg");
    showThemeIcon(document.getElementById("moon-icon"), theme === "light", "90deg");
  }

  function initThemeToggle() {
    applyTheme(preferredTheme());

    const toggle = document.getElementById("theme-toggle");
    toggle.onclick = () => {
      const next = preferredTheme() === "dark" ? "light" : "dark";
      localStorage.setItem("theme", next);
      applyTheme(next);
    };
  }

  function initHeaderAutoHide() {
    const header = document.getElementById("site-header");
    let lastScrollY = window.scrollY;
    let ticking = false;

    function updateHeader() {
      const currentY = window.scrollY;
      const isScrollingDown = currentY > lastScrollY && currentY > HEADER_HIDE_THRESHOLD_PX;
      header.style.transform = isScrollingDown ? "translateY(-100%)" : "translateY(0)";
      lastScrollY = currentY;
      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );
  }

  function drawMenuIcon(isOpen) {
    const firstLine = document.getElementById("menu-line-1");
    const secondLine = document.getElementById("menu-line-2");
    const menuLines = [
      { line: firstLine, openRotation: "rotate(45 12 12)", closedY: "8" },
      { line: secondLine, openRotation: "rotate(-45 12 12)", closedY: "16" },
    ];
    for (const { line, openRotation, closedY } of menuLines) {
      if (isOpen) {
        line.setAttribute("transform", openRotation);
      } else {
        line.removeAttribute("transform");
      }
      const lineY = isOpen ? "12" : closedY;
      line.setAttribute("y1", lineY);
      line.setAttribute("y2", lineY);
    }
  }

  function initMobileMenu() {
    const mobileButton = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!mobileButton || !mobileMenu) {
      return;
    }
    let menuOpen = false;
    mobileMenu.style.maxHeight = "0";

    mobileButton.onclick = () => {
      menuOpen = !menuOpen;
      mobileMenu.style.maxHeight = menuOpen ? mobileMenu.scrollHeight + "px" : "0";
      drawMenuIcon(menuOpen);
    };
  }

  function initLayout() {
    const themeElementIds = ["theme-toggle", "sun-icon", "moon-icon"];
    if (!themeElementIds.every((elementId) => document.getElementById(elementId))) {
      return;
    }
    initCommandPaletteHint();
    initLanguageToggle();
    initThemeToggle();
    initHeaderAutoHide();
    initMobileMenu();
  }

  function revealOnScroll() {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    for (const element of document.querySelectorAll(".scroll-reveal")) {
      observer.observe(element);
    }
  }

  initLayout();

  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.add(preferredTheme());
    const lang = preferredLang();
    document.documentElement.setAttribute("data-lang", lang);
    document.documentElement.lang = lang === "es" ? "es-AR" : "en";
    initLayout();
  });

  document.addEventListener("astro:page-load", () => {
    applyLang(preferredLang());

    for (const element of document.querySelectorAll(".hero-reveal")) {
      const delay = parseInt(element.dataset.delay || "0", 10);
      setTimeout(() => element.classList.add("visible"), HERO_REVEAL_BASE_DELAY_MS + delay);
    }

    revealOnScroll();
  });
</script>
