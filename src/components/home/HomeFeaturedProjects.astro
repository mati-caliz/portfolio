---
import { getFeaturedProjects } from "../../data/projects";

const STAGGER_DELAY_MS = 100;
const VISIBLE_STACK_SIZE = 3;

const featured = getFeaturedProjects();
---

<section class="py-[var(--spacing-section)] border-t border-border">
  <div class="max-w-5xl mx-auto px-[var(--spacing-container)]">
    <div class="flex items-end justify-between mb-12">
      <div>
        <p
          class="text-xs font-mono text-accent mb-3 uppercase tracking-widest scroll-reveal"
          data-i18n-es="Trabajo destacado"
        >
          Featured work
        </p>
        <h2
          class="text-3xl sm:text-4xl font-bold tracking-tight scroll-reveal"
          data-i18n-es="Proyectos Seleccionados"
        >
          Selected Projects
        </h2>
      </div>
      <a
        href="/projects"
        class="hidden sm:flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition-colors duration-200 group scroll-reveal"
      >
        <span data-i18n-es="Ver todos">View all</span>
        <svg
          class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
          ></path>
        </svg>
      </a>
    </div>

    <div class="space-y-4">
      {featured.map((project, i) => (
        <a
          href={`/projects/${project.slug}`}
          class="group block scroll-reveal"
          style={`transition-delay: ${i * STAGGER_DELAY_MS}ms;`}
        >
          <div class="relative border border-border rounded-xl p-6 sm:p-8 transition-all duration-300 hover:border-border-hover hover:bg-bg-secondary overflow-hidden">
            <!-- Accent line -->
            <div
              class="absolute top-0 left-0 w-1 h-full scale-y-0 group-hover:scale-y-100 transition-transform duration-500 origin-top rounded-l-xl"
              style={`background: ${project.color};`}
            ></div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="text-lg sm:text-xl font-bold group-hover:text-accent transition-colors duration-200">
                    {project.title}
                  </h3>
                  <span
                    class="px-2 py-0.5 text-xs font-mono rounded-full border border-border text-text-tertiary"
                    data-i18n-es={project.category === "work" ? "Profesional" : "Emprendimiento"}
                  >
                    {project.category === "work" ? "Professional" : "Venture"}
                  </span>
                </div>
                <p class="text-sm text-text-secondary" data-i18n-es={project.tagline_es}>
                  {project.tagline}
                </p>
              </div>
              <div class="flex items-center gap-4 shrink-0">
                <div class="hidden sm:flex flex-wrap gap-1.5">
                  {project.stack.slice(0, VISIBLE_STACK_SIZE).map((tech) => (
                    <span class="px-2 py-0.5 text-xs font-mono text-text-tertiary">{tech}</span>
                  ))}
                </div>
                <svg
                  class="w-5 h-5 text-text-tertiary group-hover:text-accent transition-all duration-200 group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"
                  ></path>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Mobile "view all" -->
    <a
      href="/projects"
      class="sm:hidden flex items-center justify-center gap-2 mt-8 py-3 text-sm font-medium text-text-secondary hover:text-accent transition-colors duration-200 scroll-reveal"
    >
      <span data-i18n-es="Ver todos los proyectos">View all projects</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
      </svg>
    </a>
  </div>
</section>
