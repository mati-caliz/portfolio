---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");

const statusColors = {
  production: "bg-emerald-500",
  "in-progress": "bg-amber-500",
  completed: "bg-blue-500",
};
---

<a
  href={`/projects/${project.slug}`}
  class="group block scroll-reveal"
  style={`transition-delay: ${index * 80}ms;`}
>
  <article class="relative h-full border border-border rounded-2xl p-6 sm:p-8 transition-all duration-300 hover:border-border-hover hover:bg-bg-secondary overflow-hidden">
    <!-- Accent glow on hover -->
    <div
      class="absolute top-0 right-0 w-32 h-32 rounded-full blur-3xl opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"
      style={`background: ${project.color};`}
    ></div>

    <div class="relative z-10">
      <!-- Top row: number + status -->
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-mono text-text-tertiary">{num}</span>
        <div class="flex items-center gap-1.5">
          <span class={`w-1.5 h-1.5 rounded-full ${statusColors[project.status]}`}></span>
          <span class="text-xs font-mono text-text-tertiary">{project.statusLabel}</span>
        </div>
      </div>

      <!-- Category badge -->
      <div class="mb-3">
        <span
          class="inline-block px-2.5 py-0.5 text-xs font-mono rounded-full border border-border text-text-tertiary"
        >
          {project.category === "work" ? "Professional" : project.category === "venture" ? "Venture" : "Open Source"}
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-bold mb-2 group-hover:text-accent transition-colors duration-200">
        {project.title}
      </h3>

      <!-- Tagline -->
      <p class="text-sm text-text-secondary leading-relaxed mb-6">
        {project.tagline}
      </p>

      <!-- Stack -->
      <div class="flex flex-wrap gap-1.5 mb-6">
        {project.stack.slice(0, 5).map((tech) => (
          <span class="px-2 py-0.5 text-xs font-mono text-text-tertiary bg-bg-secondary rounded border border-border">
            {tech}
          </span>
        ))}
        {project.stack.length > 5 && (
          <span class="px-2 py-0.5 text-xs font-mono text-text-tertiary">
            +{project.stack.length - 5}
          </span>
        )}
      </div>

      <!-- Key highlight -->
      <div class="flex items-start gap-2 text-sm text-text-secondary">
        <svg class="w-4 h-4 mt-0.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
        <span>{project.highlights[0]}</span>
      </div>
    </div>

    <!-- Bottom border accent on hover -->
    <div
      class="absolute bottom-0 left-0 right-0 h-px scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"
      style={`background: ${project.color};`}
    ></div>
  </article>
</a>

