---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette";
import { ANALYTICS_PATH, ANALYTICS_WEBSITE_ID } from "../data/analytics";
import LayoutScript from "../components/layout/LayoutScript.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Matias Caliz | Full Stack Engineer",
  description = "Full Stack Engineer building products that matter. Currently at Despegar.",
  image = "/og.png",
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? Astro.url).href;
const ogImage = new URL(image, Astro.site ?? Astro.url).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Matias Caliz",
  url: Astro.site?.href ?? "https://matiascaliz.com.ar/",
  image: ogImage,
  jobTitle: "Full Stack Software Engineer",
  worksFor: { "@type": "Organization", name: "Despegar", url: "https://www.despegar.com" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "UADE", url: "https://www.uade.edu.ar" },
  address: { "@type": "PostalAddress", addressRegion: "Buenos Aires", addressCountry: "AR" },
  knowsLanguage: ["es-AR", "en"],
  sameAs: ["https://github.com/mati-caliz", "https://www.linkedin.com/in/matias-caliz/"],
  knowsAbout: ["TypeScript", "React", "Java", "Spring", "Python", "Docker", "Software architecture"],
};
const navLinks = [
  { href: "/projects", label: "Projects", labelEs: "Proyectos" },
  { href: "/experience", label: "Experience", labelEs: "Experiencia" },
  { href: "/about", label: "About", labelEs: "Sobre mí" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Matias Caliz" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Matias Caliz" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Matias Caliz — Full Stack Engineer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_AR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />

    <!-- Fonts (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline></script>
    <!-- Astro View Transitions -->
    <ClientRouter />

    <script
      is:inline
      defer
      src={`${ANALYTICS_PATH}/script.js`}
      data-website-id={ANALYTICS_WEBSITE_ID}
      data-host-url={ANALYTICS_PATH}
      data-domains={Astro.site?.hostname}
      data-do-not-track="true"
      data-performance="true"
    ></script>
    <!-- Prevent FOUC for dark mode + language -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme =
          stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.add(theme);

        const lang =
          localStorage.getItem("lang") ||
          ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en");
        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.lang = lang === "es" ? "es-AR" : "en";
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md transition-transform duration-300"
      transition:persist
    >
      <nav class="max-w-5xl mx-auto px-[var(--spacing-container)] h-16 flex items-center justify-between">
        <!-- Logo -->
        <a
          href="/"
          class="text-lg font-semibold tracking-tight text-text hover:text-accent transition-colors duration-300 relative group"
          transition:name="logo"
        >
          MC<span class="text-accent">.</span>
          <span class="absolute -bottom-1 left-0 w-0 h-px bg-accent transition-all duration-300 group-hover:w-full"></span>
        </a>

        <div class="flex items-center gap-8">
          <!-- Desktop nav -->
          <ul class="hidden sm:flex items-center gap-1 text-sm font-medium">
            {navLinks.map(({ href, label, labelEs }) => {
              const isActive = pathname === href || pathname === href + "/";
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "relative px-3 py-2 rounded-lg transition-colors duration-200",
                      isActive
                        ? "text-text bg-bg-secondary"
                        : "text-text-secondary hover:text-text hover:bg-bg-secondary",
                    ]}
                    data-astro-prefetch
                    data-i18n-es={labelEs}
                  >
                    {label}
                    {isActive && (
                      <span
                        class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-accent"
                        transition:name={`nav-dot-${href}`}
                      />
                    )}
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- Command palette hint -->
          <button
            id="cmd-k-hint"
            type="button"
            aria-label="Open command palette"
            class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-border text-text-tertiary hover:text-text hover:border-border-hover hover:bg-bg-secondary transition-all duration-200 text-xs font-mono"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              />
            </svg>
            <kbd class="text-[10px]">&#8984;K</kbd>
          </button>

          <!-- Language toggle -->
          <button
            id="lang-toggle"
            type="button"
            aria-label="Switch language"
            class="p-2 rounded-lg text-text-secondary hover:text-text hover:bg-bg-secondary transition-all duration-200 text-xs font-mono font-bold tracking-wide"
          >
            EN
          </button>

          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="relative p-2 rounded-lg text-text-secondary hover:text-text hover:bg-bg-secondary transition-all duration-200"
          >
            <svg
              class="w-5 h-5 transition-transform duration-300"
              id="sun-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
              ></path>
            </svg>
            <svg
              class="w-5 h-5 absolute inset-0 m-auto transition-transform duration-300"
              id="moon-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
              ></path>
            </svg>
          </button>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open menu"
            class="sm:hidden p-2 rounded-lg text-text-secondary hover:text-text hover:bg-bg-secondary transition-colors duration-200"
          >
            <svg
              class="w-5 h-5 transition-transform duration-200"
              id="menu-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <line
                x1="4"
                y1="8"
                x2="20"
                y2="8"
                class="origin-center transition-all duration-300"
                id="menu-line-1"
              />
              <line
                x1="4"
                y1="16"
                x2="20"
                y2="16"
                class="origin-center transition-all duration-300"
                id="menu-line-2"
              />
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="sm:hidden overflow-hidden transition-all duration-300 ease-out"
        style="max-height: 0;"
      >
        <div class="border-t border-border bg-bg/95 backdrop-blur-md">
          <ul class="flex flex-col gap-1 p-4 text-sm font-medium">
            {navLinks.map(({ href, label, labelEs }) => {
              const isActive = pathname === href || pathname === href + "/";
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "block py-2.5 px-3 rounded-lg transition-colors duration-200",
                      isActive
                        ? "text-text bg-bg-secondary"
                        : "text-text-secondary hover:bg-bg-secondary hover:text-text",
                    ]}
                    data-astro-prefetch
                    data-i18n-es={labelEs}
                  >
                    {label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </header>

    <!-- Command Palette -->
    <div transition:persist="command-palette">
      <CommandPalette client:idle />
    </div>

    <main class="flex-1 pt-16" transition:animate="fade">
      <slot />
    </main>

    <SiteFooter />

    <LayoutScript />
  </body>
</html>
