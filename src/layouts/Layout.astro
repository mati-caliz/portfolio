---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Matias Caliz | Full Stack Engineer",
  description = "Full Stack Engineer building products that matter. Currently at Despegar.",
} = Astro.props;

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/projects", label: "Projects", labelEs: "Proyectos" },
  { href: "/experience", label: "Experience", labelEs: "Experiencia" },
  { href: "/about", label: "About", labelEs: "Sobre mí" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />

    <!-- Fonts (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Prevent FOUC for dark mode + language -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.add(theme);

        const lang = (localStorage.getItem("lang") || ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en"));
        document.documentElement.setAttribute("data-lang", lang);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md transition-transform duration-300"
      transition:persist
    >
      <nav class="max-w-5xl mx-auto px-[var(--spacing-container)] h-16 flex items-center justify-between">
        <!-- Logo -->
        <a
          href="/"
          class="text-lg font-semibold tracking-tight text-text hover:text-accent transition-colors duration-300 relative group"
          transition:name="logo"
        >
          MC<span class="text-accent">.</span>
          <span class="absolute -bottom-1 left-0 w-0 h-px bg-accent transition-all duration-300 group-hover:w-full"></span>
        </a>

        <div class="flex items-center gap-8">
          <!-- Desktop nav -->
          <ul class="hidden sm:flex items-center gap-1 text-sm font-medium">
            {navLinks.map(({ href, label, labelEs }) => {
              const isActive = pathname === href || pathname === href + "/";
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "relative px-3 py-2 rounded-lg transition-colors duration-200",
                      isActive
                        ? "text-text bg-bg-secondary"
                        : "text-text-secondary hover:text-text hover:bg-bg-secondary",
                    ]}
                    data-astro-prefetch
                    data-i18n-es={labelEs}
                  >
                    {label}
                    {isActive && (
                      <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-accent" transition:name={`nav-dot-${href}`} />
                    )}
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- Command palette hint -->
          <button
            id="cmd-k-hint"
            type="button"
            aria-label="Open command palette"
            class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-border text-text-tertiary hover:text-text hover:border-border-hover hover:bg-bg-secondary transition-all duration-200 text-xs font-mono"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
            <kbd class="text-[10px]">&#8984;K</kbd>
          </button>

          <!-- Language toggle -->
          <button
            id="lang-toggle"
            type="button"
            aria-label="Switch language"
            class="p-2 rounded-lg text-text-secondary hover:text-text hover:bg-bg-secondary transition-all duration-200 text-xs font-mono font-bold tracking-wide"
          >
            EN
          </button>

          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="relative p-2 rounded-lg text-text-secondary hover:text-text hover:bg-bg-secondary transition-all duration-200"
          >
            <svg
              class="w-5 h-5 transition-transform duration-300"
              id="sun-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
              ></path>
            </svg>
            <svg
              class="w-5 h-5 absolute inset-0 m-auto transition-transform duration-300"
              id="moon-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
              ></path>
            </svg>
          </button>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Open menu"
            class="sm:hidden p-2 rounded-lg text-text-secondary hover:text-text hover:bg-bg-secondary transition-colors duration-200"
          >
            <svg class="w-5 h-5 transition-transform duration-200" id="menu-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <line x1="4" y1="8" x2="20" y2="8" class="origin-center transition-all duration-300" id="menu-line-1" />
              <line x1="4" y1="16" x2="20" y2="16" class="origin-center transition-all duration-300" id="menu-line-2" />
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="sm:hidden overflow-hidden transition-all duration-300 ease-out"
        style="max-height: 0;"
      >
        <div class="border-t border-border bg-bg/95 backdrop-blur-md">
          <ul class="flex flex-col gap-1 p-4 text-sm font-medium">
            {navLinks.map(({ href, label, labelEs }) => {
              const isActive = pathname === href || pathname === href + "/";
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      "block py-2.5 px-3 rounded-lg transition-colors duration-200",
                      isActive
                        ? "text-text bg-bg-secondary"
                        : "text-text-secondary hover:bg-bg-secondary hover:text-text",
                    ]}
                    data-astro-prefetch
                    data-i18n-es={labelEs}
                  >
                    {label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </header>

    <!-- Command Palette -->
    <div transition:persist="command-palette">
      <CommandPalette client:idle />
    </div>

    <main class="flex-1 pt-16" transition:animate="fade">
      <slot />
    </main>

    <footer class="border-t border-border" transition:name="footer">
      <div class="max-w-5xl mx-auto px-[var(--spacing-container)] py-16">
        <div class="flex flex-col sm:flex-row items-start justify-between gap-8 mb-12">
          <div>
            <a href="/" class="text-lg font-semibold tracking-tight text-text hover:text-accent transition-colors duration-300">
              MC<span class="text-accent">.</span>
            </a>
            <div class="flex items-center gap-2 mt-3 text-sm text-text-secondary">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span data-i18n-es="Actualmente en Despegar">Currently at Despegar</span>
            </div>
          </div>

          <div class="flex gap-8 text-sm">
            <div class="space-y-2">
              <p class="text-xs font-mono text-text-tertiary uppercase tracking-widest mb-3" data-i18n-es="Páginas">Pages</p>
              <a href="/projects" class="block text-text-secondary hover:text-text transition-colors duration-200" data-astro-prefetch data-i18n-es="Proyectos">Projects</a>
              <a href="/experience" class="block text-text-secondary hover:text-text transition-colors duration-200" data-astro-prefetch data-i18n-es="Experiencia">Experience</a>
              <a href="/about" class="block text-text-secondary hover:text-text transition-colors duration-200" data-astro-prefetch data-i18n-es="Sobre mí">About</a>
            </div>
            <div class="space-y-2">
              <p class="text-xs font-mono text-text-tertiary uppercase tracking-widest mb-3" data-i18n-es="Contacto">Connect</p>
              <a href="https://github.com/mati-caliz" target="_blank" rel="noopener noreferrer" class="block text-text-secondary hover:text-text transition-colors duration-200">GitHub</a>
              <a href="https://www.linkedin.com/in/matias-caliz/" target="_blank" rel="noopener noreferrer" class="block text-text-secondary hover:text-text transition-colors duration-200">LinkedIn</a>
              <a href="mailto:matiascaliz@hotmail.com" class="block text-text-secondary hover:text-text transition-colors duration-200">Email</a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <a href="https://github.com/mati-caliz" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-2 rounded-lg text-text-tertiary hover:text-text hover:bg-bg-secondary transition-all duration-200">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/matias-caliz/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-2 rounded-lg text-text-tertiary hover:text-text hover:bg-bg-secondary transition-all duration-200">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
              </svg>
            </a>
            <a href="mailto:matiascaliz@hotmail.com" aria-label="Email" class="p-2 rounded-lg text-text-tertiary hover:text-text hover:bg-bg-secondary transition-all duration-200">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="border-t border-border pt-8 flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="text-xs text-text-tertiary">
            <span data-i18n-es={`© ${new Date().getFullYear()} Matias Caliz. Hecho con Astro.`}>&copy; {new Date().getFullYear()} Matias Caliz. Built with Astro.</span>
          </p>
          <p class="text-xs text-text-tertiary">
            Buenos Aires, Argentina
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // ── i18n ──
      function applyLang(lang) {
        document.documentElement.setAttribute("data-lang", lang);
        document.querySelectorAll("[data-i18n-es]").forEach(function (el) {
          if (!el.getAttribute("data-i18n-en")) {
            el.setAttribute("data-i18n-en", el.textContent);
          }
          el.textContent = lang === "es" ? el.getAttribute("data-i18n-es") : el.getAttribute("data-i18n-en");
        });
        // Update lang toggle button text
        var langBtn = document.getElementById("lang-toggle");
        if (langBtn) langBtn.textContent = lang === "es" ? "ES" : "EN";
        // Dispatch custom event for Preact islands / scripts
        window.dispatchEvent(new CustomEvent("langchange", { detail: { lang: lang } }));
      }

      // Run on initial load AND after every view transition
      function initLayout() {
        const toggle = document.getElementById("theme-toggle");
        const sunIcon = document.getElementById("sun-icon");
        const moonIcon = document.getElementById("moon-icon");
        const header = document.getElementById("site-header");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const line1 = document.getElementById("menu-line-1");
        const line2 = document.getElementById("menu-line-2");
        const langToggle = document.getElementById("lang-toggle");

        const cmdKHint = document.getElementById("cmd-k-hint");

        if (!toggle || !sunIcon || !moonIcon) return;

        // ── Command Palette hint button ──
        if (cmdKHint) {
          cmdKHint.onclick = function () {
            window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", metaKey: true }));
          };
        }

        // ── Language ──
        var currentLang = (localStorage.getItem("lang") || ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en"));
        applyLang(currentLang);

        if (langToggle) {
          langToggle.onclick = function () {
            currentLang = currentLang === "en" ? "es" : "en";
            localStorage.setItem("lang", currentLang);
            applyLang(currentLang);
          };
        }

        // ── Theme ──
        function getTheme() {
          const stored = localStorage.getItem("theme");
          if (stored) return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        function applyTheme(theme) {
          const root = document.documentElement;
          root.classList.remove("light", "dark");
          root.classList.add(theme);
          sunIcon.style.opacity = theme === "dark" ? "1" : "0";
          sunIcon.style.transform = theme === "dark" ? "rotate(0deg) scale(1)" : "rotate(-90deg) scale(0)";
          moonIcon.style.opacity = theme === "light" ? "1" : "0";
          moonIcon.style.transform = theme === "light" ? "rotate(0deg) scale(1)" : "rotate(90deg) scale(0)";
        }

        applyTheme(getTheme());

        toggle.onclick = () => {
          const next = getTheme() === "dark" ? "light" : "dark";
          localStorage.setItem("theme", next);
          applyTheme(next);
        };

        // ── Header hide/show ──
        let lastScrollY = window.scrollY;
        let ticking = false;

        function updateHeader() {
          const currentY = window.scrollY;
          if (currentY > lastScrollY && currentY > 80) {
            header.style.transform = "translateY(-100%)";
          } else {
            header.style.transform = "translateY(0)";
          }
          lastScrollY = currentY;
          ticking = false;
        }

        window.addEventListener("scroll", () => {
          if (!ticking) {
            requestAnimationFrame(updateHeader);
            ticking = true;
          }
        }, { passive: true });

        // ── Mobile menu ──
        let menuOpen = false;
        if (mobileBtn && mobileMenu) {
          // Reset on navigation
          mobileMenu.style.maxHeight = "0";
          menuOpen = false;

          mobileBtn.onclick = () => {
            menuOpen = !menuOpen;
            if (menuOpen) {
              mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
              line1.setAttribute("transform", "rotate(45 12 12)");
              line1.setAttribute("y1", "12");
              line1.setAttribute("y2", "12");
              line2.setAttribute("transform", "rotate(-45 12 12)");
              line2.setAttribute("y1", "12");
              line2.setAttribute("y2", "12");
            } else {
              mobileMenu.style.maxHeight = "0";
              line1.removeAttribute("transform");
              line1.setAttribute("y1", "8");
              line1.setAttribute("y2", "8");
              line2.removeAttribute("transform");
              line2.setAttribute("y1", "16");
              line2.setAttribute("y2", "16");
            }
          };
        }
      }

      // Run on first load
      initLayout();

      // Re-run after view transitions swap
      document.addEventListener("astro:after-swap", () => {
        // Re-apply dark mode class (it gets removed on swap)
        const stored = localStorage.getItem("theme");
        const theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.add(theme);
        // Re-apply language
        const lang = (localStorage.getItem("lang") || ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en"));
        document.documentElement.setAttribute("data-lang", lang);
        initLayout();
      });

      // Re-trigger page animations + language after navigation
      document.addEventListener("astro:page-load", () => {
        // Re-apply language on every page load (most reliable timing)
        var pageLang = (localStorage.getItem("lang") || ((navigator.language || "en").toLowerCase().startsWith("es") ? "es" : "en"));
        applyLang(pageLang);

        // Hero reveals
        document.querySelectorAll(".hero-reveal").forEach((el) => {
          const delay = parseInt(el.dataset.delay || "0", 10);
          setTimeout(() => el.classList.add("visible"), 100 + delay);
        });

        // Scroll reveals
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll(".scroll-reveal").forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
